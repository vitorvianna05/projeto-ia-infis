    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.2.3" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Documentos\" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Documentos\**\*.md" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>

